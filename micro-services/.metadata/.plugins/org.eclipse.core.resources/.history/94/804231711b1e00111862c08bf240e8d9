eureka.client.serviceUrl.defaultZone=http://localhost:8761/registery/eureka

# Enable dynamic routing 
spring.cloud.gateway.discovery.locator.enabled=true
spring.cloud.gateway.server.webflux.discovery.locator.enabled=true

# To convert url to lowercase
spring.cloud.gateway.discovery.locator.lower-case-service-id=true

spring.cloud.gateway.routes[0].id=user-service
spring.cloud.gateway.routes[0].uri=lb://users
spring.cloud.gateway.routes[0].predicates[0]=Path=/users/**
spring.cloud.gateway.routes[0].filters[0]=CircuitBreaker=name=userServiceCB,fallbackUri=forward:/fallback/users

resilience4j.timelimiter.instances.userServiceCB.timeout-duration=6s
resilience4j.circuitbreaker.instances.userServiceCB.sliding-window-size=4
resilience4j.circuitbreaker.instances.demoService.minimum-number-of-calls=4
resilience4j.circuitbreaker.instances.userServiceCB.failure-rate-threshold=50

resilience4j.circuitbreaker.instances.userServiceCB.register-health-indicator=true
resilience4j.circuitbreaker.instances.userServiceCB.sliding-window-type=COUNT_BASED
resilience4j.circuitbreaker.instances.userServiceCB.wait-duration-in-open-state=4s
resilience4j.circuitbreaker.instances.userServiceCB.permitted-number-of-calls-in-half-open-state=2


resilience4j.timelimiter.instances.userServiceCB.cancel-running-future=true

management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always

