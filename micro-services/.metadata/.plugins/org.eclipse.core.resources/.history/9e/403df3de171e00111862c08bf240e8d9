package com.lpu.users.controller;

import io.github.resilience4j.circuitbreaker.annotation.CircuitBreaker;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class TestController {

    @GetMapping("/test")
    @CircuitBreaker(name = "userServiceCB", fallbackMethod = "fallBack")
    public String testService() throws InterruptedException {

        Thread.sleep(10000); // simulate slow response

        return "Service response";
    }

    public String fallBack(Exception ex) {
        System.out.println("Fallback executed");
        return "Fallback response - Circuit Breaker active";
    }
}